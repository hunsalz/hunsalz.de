---
import { Icon } from "astro-icon/components";
---

<nav class="social" aria-label="Social links">
    <a href="https://github.com/hunsalz" target="_blank" rel="noopener noreferrer"><Icon name="mdi:github" aria-hidden="true" />GitHub</a>
    <a href="https://www.linkedin.com/in/markus-hunsalz" target="_blank" rel="noopener noreferrer"><Icon name="mdi:linkedin" aria-hidden="true" />LinkedIn</a>
</nav>

<style>
    .social {
        display: flex;
        justify-content: center;
        gap: clamp(1.5rem, 4vw, 3rem);
        margin-top: clamp(1.5rem, 3vw, 2.5rem);
        font-family: "Open Sans", sans-serif;
        font-size: 0.8125rem;
        letter-spacing: 0.025em;
    }

    a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;
        color: var(--ink);
        text-decoration: none;
        transition: color 160ms ease;
    }

    a :global(svg) {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
    }

    a:hover {
        color: #a34f35;
    }

    a:focus-visible {
        outline: 2px solid #a34f35;
        outline-offset: 6px;
        border-radius: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
        a { transition: none; }
    }
</style>
