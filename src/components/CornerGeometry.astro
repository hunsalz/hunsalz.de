---
interface Props {
    upper?: boolean;
}

const { upper = false } = Astro.props;
---

<div class:list={["geometry", { "geometry-upper": upper }]} aria-hidden="true">
    <svg viewBox="0 0 800 650" fill="none" focusable="false">
        <g
            stroke="currentColor"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
        >
            <rect
                x="-180"
                y="300"
                width="570"
                height="390"
                transform="rotate(-19 105 495)"
            />
            <rect
                x="-110"
                y="370"
                width="650"
                height="300"
                transform="rotate(-32 215 520)"
            />
            <rect
                class="accent"
                x="-160"
                y="420"
                width="630"
                height="260"
                transform="rotate(-12 155 550)"
            />
            <rect
                x="-240"
                y="230"
                width="520"
                height="520"
                transform="rotate(14 20 490)"
            />
        </g>
    </svg>
</div>

<style>
    .geometry {
        position: absolute;
        z-index: -1;
        left: 0;
        bottom: 0;
        width: min(65vw, 900px);
        height: min(75svh, 730px);
        color: rgb(37 38 34 / 18%);
        pointer-events: none;
        -webkit-mask-image: radial-gradient(
            ellipse at 0% 100%,
            #000 8%,
            transparent 72%
        );
        mask-image: radial-gradient(
            ellipse at 0% 100%,
            #000 8%,
            transparent 72%
        );
    }

    .geometry-upper {
        left: auto;
        bottom: auto;
        top: 0;
        right: 0;
        transform: rotate(180deg);
        opacity: 0.65;
    }

    .geometry svg {
        width: 100%;
        height: 100%;
    }

    .geometry .accent {
        stroke: rgb(163 79 53 / 55%);
        opacity: 0.3;
    }

    @media (max-width: 540px) {
        .geometry {
            width: 100vw;
            height: 48svh;
        }
    }
</style>
