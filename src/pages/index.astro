---
import Layout from "../layouts/Default.astro";
import Social from "../components/Social.astro";
---

<Layout
    title="Markus Hunsalz"
    description="Markus Hunsalz’s personal website. Find me on GitHub and LinkedIn."
>
    <section class="poster" aria-label="Introduction">
        <div class="identity">
            <h1><span>Markus</span> <span>Hunsalz</span></h1>
            <Social />
        </div>
    </section>
</Layout>

<style>
    .poster {
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 3rem 1.5rem;
    }

    .identity {
        width: 100%;
        text-align: center;
    }

    h1 {
        margin: 0;
        font-family: "Overpass", "Arial Black", sans-serif;
        font-size: clamp(2.5rem, 10vw, 11rem);
        font-weight: 800;
        letter-spacing: -0.065em;
        line-height: 1.08;
    }

    h1 span {
        position: relative;
        display: inline-block;
    }

    h1 span::after {
        content: "";
        position: absolute;
        left: -0.02em;
        right: -0.02em;
        top: 46%;
        height: 0.032em;
        background: var(--paper);
        pointer-events: none;
    }

    @media (max-width: 540px) {
        h1 {
            font-size: clamp(3rem, 18vw, 6rem);
            line-height: 1.02;
        }

        h1 span {
            display: block;
            width: fit-content;
            margin-inline: auto;
        }
    }
</style>
