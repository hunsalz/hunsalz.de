{
    "name": "hunsalz.de-astro",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "eslint . --ext .js,.ts,.astro",
        "format": "prettier --write \"**/*.{js,ts,json,css,astro}\"",
        "check": "npm run lint && astro check && astro build"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/sitemap": "^3.7.4",
        "@fontsource/open-sans": "^5.3.0",
        "@fontsource/overpass": "^5.3.0",
        "astro": "^7.4.5",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "typescript-eslint": "^8.72.1"
    },
    "engines": {
        "node": ">=22.23.4"
    },
    "overrides": {
        "minimatch@^10": "11.0.1"
    }
}
